# Shared POST input for config3 pressure-only runs. Do not run directly: charles-post-noInt.slurm
# copies it to <run scratch>/post/<step>/ and replaces SNAPSHOT with the 8-digit step.
POST
RESTART = /oak/stanford/groups/gorle/nbachand/Cascade/city_block_cfd/STITCH/config3/13M-mesh-noInteriors.mles ../../data/result.SNAPSHOT.sles

#Equation of state
EOS HELMHOLTZ
RHO = 1.225
MU = 1.7894e-5
HELMHOLTZ_SOS 340.65

#Boundary Conditions (pressure-only mesh zones)
buildings     = WM_ALG_WALL                          T 0  D 0  S 0
ground        = WM_ALG_WALL ROUGHNESS_HEIGHT 0.0032  T 0  D 0  S 0
top           = SLIP                                 T 0  D 0  S 0
interior      =  WM_ALG_WALL                         T 0  D 0  S 0

STATS u mag(u) p
OVERWRITE_STATS=false #default true

DEFINE flush_probes=1000
DEFINE probe_path=probes/probesOut
DEFINE location_path=/oak/stanford/groups/gorle/nbachand/Cascade/city_block_cfd/CHARLES/config3/noInt_locations
FLUSH_PROBES $(flush_probes)
DEFINE probe_int=1
DEFINE image_int_avg=1
DEFINE image_int=1

# Opening surface point clouds (config3/charles-post.in, switched on)
POINTCLOUD_PROBE NAME=$(probe_path)/xwindow_0-0_h_-1-0         INTERVAL $(probe_int) PRECISION FLOAT GEOM FILE $(location_path)/xwindow_0-0_h_-1-0.txt        VARS p_avg p_rms comp(u_avg,0) comp(u_avg,1) comp(u_avg,2)
POINTCLOUD_PROBE NAME=$(probe_path)/zwindow_0-0_h_-1-0         INTERVAL $(probe_int) PRECISION FLOAT GEOM FILE $(location_path)/zwindow_0-0_h_-1-0.txt        VARS p_avg p_rms comp(u_avg,0) comp(u_avg,1) comp(u_avg,2)
